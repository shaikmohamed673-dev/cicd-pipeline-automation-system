{
  "name": "cicd-pipeline-automation-system",
  "version": "1.0.0",
  "description": "Production-grade CI/CD Pipeline Automation System with Jenkins, Docker, and Automated Testing",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --detectOpenHandles --runInBand --reporters=default --reporters=jest-junit",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/ --ext .js"
  },
  "keywords": [
    "cicd",
    "jenkins",
    "docker",
    "docker-hub",
    "automation",
    "devops",
    "testing",
    "express"
  ],
  "author": "Shaik Mohamed <shaikmohamed673@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "jest-junit": {
    "outputDirectory": "./test-results",
    "outputName": "junit.xml"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
